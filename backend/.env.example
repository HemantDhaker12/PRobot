# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
# PostgreSQL Database URL. Example: postgresql://postgres:postgres@localhost:5432/probot
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/probot

# Vector Database Configuration
# Path to persist ChromaDB files locally
CHROMA_PATH=./chroma_db

# Background Tasks & Cache
# Redis URL for Celery broker and result backend. Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# GitHub Integration
# Personal Access Token with repo/metadata scope
GITHUB_TOKEN=your_github_token_here
# Secret token configured in the GitHub webhook settings for security validation
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Integration
# Groq API key for Llama model inference
GROQ_API_KEY=your_groq_api_key_here
